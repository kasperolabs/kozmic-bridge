# eth-prover GPU image: STARK proving (and, where it works, the Groth16 wrap) on the GPU.
#
# Build (x86_64 box with Docker, no GPU needed; BuildKit cache mounts make rebuilds after a source change
# take minutes instead of the ~30 min first build):
#   docker build -f docker/Dockerfile.cuda -t kasperolabs/eth-prover:cuda .
# Run on a rented GPU pod: the container starts sshd if $PUBLIC_KEY is set (RunPod convention) and idles.
#
# Measured 2026-10-12 on an RTX 4090: STARK + recursion for the minimal-spec fixture in 57 s (CPU, 12 cores: 1 h 56 min).
# Known issue: the CUDA Groth16 wrap (risc0-groth16-sys / sppark) dies with "an illegal memory access" on that
# box. Workflow that works: `prove --no-wrap` on the GPU (saves receipt.succinct.bin), then `wrap` on a box with
# Docker (risczero/risc0-groth16-prover image, ~2 min on CPU).
#
# Kernels are built for sm_89 (RTX 4090, 4080, L4, RTX 6000 Ada) plus PTX, which JITs on newer cards (H100).
# A 3090 (sm_86) needs "-gencode arch=compute_86,code=sm_86" added to NVCC_APPEND_FLAGS.

# ---------- build stage ----------
FROM nvidia/cuda:12.6.3-devel-ubuntu22.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev curl git ca-certificates xz-utils \
        protobuf-compiler clang libclang-dev \
    && rm -rf /var/lib/apt/lists/*

# Host Rust (stable)
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:/usr/local/cuda/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

# RISC Zero: guest Rust toolchain (>= 1.90 for this dependency tree), r0vm 3.0.4, native Groth16 parameters.
# rzup installs under /root/.risc0, which is copied into the runtime image (the prover looks the
# groth16 component up through rzup).
RUN curl -L https://risczero.com/install | bash \
    && /root/.risc0/bin/rzup install rust 1.94.1 \
    && /root/.risc0/bin/rzup install r0vm 3.0.4 \
    && /root/.risc0/bin/rzup install risc0-groth16
ENV PATH=/root/.risc0/bin:$PATH

# No GPU in the build container: name the target arch instead of letting risc0 use -arch=native.
ENV NVCC_APPEND_FLAGS="-gencode arch=compute_80,code=sm_80 -gencode arch=compute_86,code=sm_86 -gencode arch=compute_89,code=sm_89 -gencode arch=compute_90,code=sm_90 -gencode arch=compute_90,code=compute_90"

WORKDIR /src
COPY . .
# Cache mounts: registry, git checkouts and target dir persist across builds (needs BuildKit, the default).
# The binary is copied out of the cache mount because cache contents are not part of the image layer.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --features cuda -p eth-bridge-host \
    && cp target/release/eth-prover /eth-prover

# ---------- runtime stage ----------
FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libssl3 git curl openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd /root/.ssh && chmod 700 /root/.ssh
COPY --from=build /eth-prover /usr/local/bin/eth-prover
COPY --from=build /root/.risc0 /root/.risc0
COPY docker/pod-start.sh /usr/local/bin/pod-start.sh
RUN chmod +x /usr/local/bin/pod-start.sh
WORKDIR /work
CMD ["/usr/local/bin/pod-start.sh"]
